[Unit]
Description=R4OS Studio WebApp
Wants=network-online.target
After=network-online.target r4-link-firewall.service
RequiresMountsFor="@APP_DIRECTORY@"
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=root
Group=root
Type=exec
WorkingDirectory=@APP_DIRECTORY@
ExecStart="@NODE_BINARY@" "@APP_DIRECTORY@/backend/dist/server.js" --serve-frontend
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=5010
Environment="STUDIO_DATA_DIR=@APP_DIRECTORY@/Data/LLMProvider"
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillMode=control-group
# Node.js liest die Interface-Adressen über Netlink für die Startmeldung.
UMask=0077

[Install]
WantedBy=multi-user.target
