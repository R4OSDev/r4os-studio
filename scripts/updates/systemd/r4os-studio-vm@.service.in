[Unit]
Description=R4OS Studio virtual machine %i
After=local-fs.target systemd-tmpfiles-setup.service
RequiresMountsFor="@APP_DIRECTORY@/Data/R4OS"

[Service]
Type=exec
User=r4os-studio
Group=r4os-studio
SupplementaryGroups=kvm
WorkingDirectory=@APP_DIRECTORY@
ExecStart="@NODE_BINARY@" "@APP_DIRECTORY@/backend/dist/modules/virtual-machines/runner.js" %i
ExecStopPost="@NODE_BINARY@" "@APP_DIRECTORY@/backend/dist/modules/virtual-machines/runner.js" %i --sync
Environment="STUDIO_R4OS_DIR=@APP_DIRECTORY@/Data/R4OS"
Environment=STUDIO_VM_RUNTIME_DIR=/run/r4os-studio-vms
RuntimeDirectory=r4os-studio-vms/%i
RuntimeDirectoryMode=0700
ReadWritePaths="@APP_DIRECTORY@/Data/R4OS/Instances/%i"
ReadWritePaths=/run/r4os-studio-vms/%i
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
UMask=0077
KillMode=control-group
TimeoutStopSec=900s
Restart=no
MemoryMax=20G
TasksMax=1024
