+
+/** Ghidra's segmented input spelling for a caller's linear load address. */
+export const ghidraRawLoadAddress = (
+  architecture: RawBinaryAdmission["architecture"],
+  entry: string,
+): string => {
+  if (architecture !== "x86-16") return entry;
+  const linear = BigInt(entry);
+  const segment = ((linear >> 16n) << 12n).toString(16).padStart(4, "0");
+  const offset = (linear & 0xffffn).toString(16).padStart(4, "0");
+  return `${segment}:${offset}`;
+};
